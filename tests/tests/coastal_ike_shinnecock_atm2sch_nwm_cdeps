# nwm / dnwm (CDEPS data-river) — Phase 0 artifacts
export NWM_CDEPS=true
export DNWM_STREAM_CONFIGURE=dnwm.streams.coastal.IN
export MESH_NWM="schism_elem_ESMFmesh.nc"
