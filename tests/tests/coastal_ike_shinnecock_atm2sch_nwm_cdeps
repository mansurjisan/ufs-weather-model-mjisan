export nwm_stream_files="\"INPUT/nwm_discharge.nc\""
export nwm_stream_variables="\"river_discharge river_volume_flux\""
# fallback if the field fails to connect (should be UNUSED on a connected run; verify logs)
export river_stub_q=100.0

# datm/ocean
export HURR="Ike"
export CPL_CONF="atm2sch"

# pes (all components share PETs 0-2)
