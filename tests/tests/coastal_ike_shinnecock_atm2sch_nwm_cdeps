###############################################################################
#
# SCHISM coupled + FULL one-way NWM river coupling via the dnwm CDEPS component
# (USE_NUOPC_RIVER, connected path): DATM + SCHISM(OCN) + NWM(dnwm) + MED.
#
# Differs from the stub test (coastal_ike_shinnecock_atm2sch_nwm) by adding the
# NWM/dnwm data component + the NWM -> OCN redist connector, so SCHISM reads a
# per-element discharge field (not the constant stub).
#
# REQUIRES (Phase 0 artifacts staged into the run; generated by
# logs/gen_nwm_phase0.py -> phase0_nwm_out/):
#   - INPUT/schism_elem_ESMFmesh.nc  (element mesh; element order == SCHISM global
#     element id == the redist contract)
#   - INPUT/nwm_discharge.nc         (river_discharge(time,nelem) [m3/s])
#   - source_sink.in                 (the 6 paired source elements)
#   - param.nml with if_source = 1
# Build with -DUSE_NUOPC_RIVER=ON. See NWM_RIVER_INCREMENT1_VALIDATION.md
# ("Phase 5 prerequisites" + "Phase 0").
#
# NOTE: full RT auto-staging (default_vars.sh export_dnwm_cdeps + fv3_conf to
# generate dnwm_in/dnwm.streams and stage the Phase-0 files) is not yet wired;
# stage manually per the validation doc for a first connected run.
###############################################################################

export TEST_DESCR="ike_shinnecock_atm2sch + one-way NWM coupling via dnwm CDEPS (connected)"

export CNTL_DIR=coastal_ike_shinnecock_atm2sch_nwm_cdeps

export LIST_FILES="outputs/schout_000000_1.nc \
                   outputs/schout_000000_2.nc \
                   ufs.cpld.cpl.hi.2008-08-24-00000.nc"

export_coastal

# model_configure
export SYEAR=2008
export SMONTH=08
export SDAY=23
export SHOUR=00
export FHMAX=24
export FHROT=0
export DT_ATMOS=720
export RESTART_INTERVAL=0
export QUILTING=.true.
export QUILTING_RESTART=.false.
export WRITE_GROUP=1
export WRTTASK_PER_GROUP=6
export OUTPUT_HISTORY=.true.
export NUM_FILES=2
export FILENAME_BASE="'atm' 'sfc'"
export OUTPUT_GRID="'cubed_sphere_grid'"
export OUTPUT_FILE="'netcdf'"
export OUTPUT_FH="12 -1"

# datm
export DATM_CDEPS=true
export DATM_STREAM_CONFIGURE=datm.streams.coastal.IN
export atm_datamode="ATMMESH"
export MESH_ATM="wind_atm_fin_ch_time_vec_ESMFmesh.nc"
