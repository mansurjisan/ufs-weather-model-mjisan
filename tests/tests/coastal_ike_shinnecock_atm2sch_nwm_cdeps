export OCN_tasks=3

# configuration
export MODEL_CONFIGURE=model_configure.IN
export UFS_CONFIGURE=ufs.configure.coastal_datm_ocn_nwm_cdeps.IN
export med_model=cmeps
export med_petlist_bounds="0 2"
