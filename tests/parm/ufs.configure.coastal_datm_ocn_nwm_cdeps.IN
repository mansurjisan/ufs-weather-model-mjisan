#############################################
####  NEMS Run-Time Configuration File  #####
#############################################
#
# Full one-way NWM river coupling: DATM + OCN + NWM(dnwm) + MED. OCN-model
# agnostic -- every directive below is templated, so this file serves both
# ocn_model=schism and ocn_model=adcirc.
#
# The dnwm CDEPS data component exports `river_volume_flux` [m3 s-1] per mesh
# entity; a direct NWM -> OCN redist connector delivers it to the ocean cap,
# which reads it (USE_NUOPC_RIVER). One-way only: nothing is exported back to
# NWM. Requires the executable built with -DUSE_NUOPC_RIVER=ON and a dnwm stream
# + ESMFmesh (model_meshfile) obeying the redist id contract, which is per ocean
# model:
#   schism: one dnwm entity per SCHISM global ELEMENT id; also needs param.nml
#           if_source=1 and a source_sink.in
#           (see NWM_RIVER_INCREMENT1_VALIDATION.md / Phase 0 pairing).
#   adcirc: one dnwm entity per ADCIRC global NODE id (natural order 1..NP);
#           also needs an IBTYPE 22/32 normal-flux boundary string in fort.14
#           (see ADCIRC_NWM_RIVER_FORCING.md).
# The OCN attributes `river_stub_q` and `nwm_coupling` below are read only by the
# ocean cap that recognizes them; a cap that does not query them ignores them.
# (For the SCHISM-side stub with no dnwm, use ufs.configure.coastal_datm_ocn_nwm.IN.)
#

# ESMF #
logKindFlag:            ESMF_LOGKIND_MULTI
globalResourceControl:  true

# EARTH #
EARTH_component_list: ATM OCN NWM MED
EARTH_attributes::
  Verbosity = 0
::

# MED #
MED_model:                      @[med_model]
MED_petlist_bounds:             @[med_petlist_bounds]
MED_omp_num_threads:            @[med_omp_num_threads]
MED_attributes::
  ATM_model = @[atm_model]
  OCN_model = @[ocn_model]
  history_n = 1
  history_option = nhours
  history_ymd = -999
  coupling_mode = @[CPLMODE]
::

# ATM #
ATM_model:                      @[atm_model]
ATM_petlist_bounds:             @[atm_petlist_bounds]
ATM_omp_num_threads:            @[atm_omp_num_threads]
ATM_attributes::
  Verbosity = 0
  DumpFields = false
  ProfileMemory = false
  OverwriteSlice = true
::

# OCN #
OCN_model:                      @[ocn_model]
OCN_petlist_bounds:             @[ocn_petlist_bounds]
OCN_omp_num_threads:            @[ocn_omp_num_threads]
OCN_attributes::
  Verbosity = 0
  DumpFields = false
  ProfileMemory = false
  OverwriteSlice = true
  meshloc = @[meshloc]
  CouplingConfig = @[coupling_config]
  river_stub_q = @[river_stub_q]
  nwm_coupling = true
::

# NWM (CDEPS dnwm data-river component) #
# nwm_model MUST resolve to "dnwm" (the driver adds the component only for
# trim(model)=="dnwm"); any other value silently drops the component.
NWM_model:                      @[nwm_model]
NWM_petlist_bounds:             @[nwm_petlist_bounds]
NWM_omp_num_threads:            @[nwm_omp_num_threads]
NWM_attributes::
  Verbosity = 0
  DumpFields = false
  ProfileMemory = false
  OverwriteSlice = true
  logfile = dnwm.log
::

# Run Sequence (one-way: NWM -> OCN direct redist; MED handles ATM<->OCN) #
#
# NOTE (runSeq order depends on the OCN cap's checkImport behavior):
# The order below (NWM advances BEFORE the NWM -> OCN connector) works for
# SCHISM because its CheckImportRiver specialization exempts the river field
# from the strict NUOPC timestamp check (zero-order hold). A cap that uses
# NUOPC's DEFAULT strict checkImport -- ADCIRC does -- will abort with
# "NUOPC INCOMPATIBILITY DETECTED: Import Fields not at current time",
# because on a direct connector nothing re-stamps the export and NUOPC
# stamps a model's export at the END of its advance. For the ADCIRC route:
#   1) move NWM to the END of the slot:   NWM -> OCN; OCN; ...; NWM
#   2) set advance_to_next_time = .true. in dnwm_in
# so window k consumes the export stamped at the start of window k with the
# value valid at that same time (zero lag). Validated in the ADCIRC runtime
# demos (see ADCIRC_NWM_RIVER_FORCING.md, section 5).
runSeq::
@@[coupling_interval_slow_sec]
  ATM -> MED :remapMethod=redist
  MED med_phases_post_atm
  OCN -> MED :remapMethod=redist
  MED med_phases_post_ocn
  MED med_phases_prep_atm
  MED med_phases_prep_ocn_accum
  MED med_phases_prep_ocn_avg
  MED -> ATM :remapMethod=redist
  MED -> OCN :remapMethod=redist
  ATM
  NWM
  NWM -> OCN :remapMethod=redist
  OCN
  MED med_phases_history_write
  MED med_phases_restart_write
@
::

ALLCOMP_attributes::
  ScalarFieldCount = 3
  ScalarFieldIdxGridNX = 1
  ScalarFieldIdxGridNY = 2
  ScalarFieldIdxNextSwCday = 3
  ScalarFieldName = cpl_scalars
  start_type = @[RUNTYPE]
  restart_dir = RESTART/
  case_name = @[casename]
  restart_n = @[RESTART_N]
  restart_option = nhours
  restart_ymd = -999
  orb_eccen = 1.e36
  orb_iyear = 2000
  orb_iyear_align = 2000
  orb_mode = fixed_year
  orb_mvelp = 1.e36
  orb_obliq = 1.e36
  stop_n = @[FHMAX]
  stop_option = nhours
  stop_ymd = -999
::
